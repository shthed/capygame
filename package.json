{
  "name": "capygame",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:unit": "tsx --test src/capygame/services/ProgressionAndPhysics.test.ts src/capygame/services/SaveAndCloudSync.test.ts src/capygame/services/AudioSynthesisMath.test.ts src/capygame/engine/UniverseAndGpuMath.test.ts src/capygame/engine/CapytorioFactoryEngine.test.ts src/capygame/engine/capytorio/CapytorioLogisticsMath.test.ts src/capygame/engine/controllers/ForestPlacementMath.test.ts src/capygame/engine/forestMicroSpecimens.test.ts src/capygame/engine/UfoFlightSequence.test.ts src/capygame/engine/TutorialCatalog.test.ts src/capygame/engine/FocusGuard.test.ts",
    "verify:playstore": "node scripts/verify-playstore-readiness.mjs",
    "test:game": "node scripts/test-capygame.mjs",
    "test:pwa": "node scripts/test-pwa-offline.mjs",
    "gallery:capture": "node scripts/capture-capygame-gallery.mjs",
    "gallery:capture:zoom": "node scripts/capture-all-zoom-levels.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
