{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capygame",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "capyboop.com",
      "custom_domain": true
    },
    {
      "pattern": "www.capyboop.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
